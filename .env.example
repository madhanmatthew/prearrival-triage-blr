ORS_API_KEY=
TOMTOM_API_KEY=       # Flow + Routing APIs (docs/19)
LLM_PROVIDER=          # empty = extractive RAG (no LLM) | openai_compat (free tier only)
LLM_BASE_URL=          # OpenAI-compatible endpoint of a free-tier provider [TODO-VERIFY]
LLM_MODEL=
LLM_API_KEY=
WHISPER_MODEL=small    # tiny|base|small
WHISPER_MODE=local     # local|api
RANDOM_SEED=42
MIMIC_DIR=data/raw/mimic_demo/mimic-iv-clinical-database-demo-2.2
