# Copy to .env and fill in. Never commit .env.
SUMO_HOME=/path/to/site-packages/sumo
ORS_API_KEY=
TOMTOM_API_KEY=       # Flow + Routing APIs (docs/19)
LLM_PROVIDER=          # empty = extractive RAG (no LLM) | openai_compat (free tier only)
LLM_BASE_URL=          # OpenAI-compatible endpoint of a free-tier provider [TODO-VERIFY]
LLM_MODEL=
LLM_API_KEY=
WHISPER_MODEL=small    # tiny|base|small|medium|large-v3|large-v3-turbo
WHISPER_MODE=local     # local|api
WHISPER_DEVICE=cpu     # cpu|cuda (cuda: pip install -r requirements-gpu.txt)
WHISPER_COMPUTE=       # empty = int8 on cpu, float16 on cuda; int8_float16 for large-v3 on a 4 GB GPU
WHISPER_REPETITION_PENALTY=1.1
RANDOM_SEED=42
MIMIC_DIR=data/raw/mimic_demo/mimic-iv-clinical-database-demo-2.2
