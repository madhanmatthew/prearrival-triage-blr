@'
# Only true junk is ignored. Everything else (datasets, models, audio, video, outputs) is tracked.

# Python caches / environments
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Secrets
.env

# Re-downloadable model caches (files over 100 MB are rejected by GitHub)
models/hf/
models/whisper/

# OS
.DS_Store
Thumbs.db
'@ | Set-Content .gitignore -Encoding utf8