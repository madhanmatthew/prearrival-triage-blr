# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Secrets
.env

# Data (licence-restricted: MIMIC must never be committed)
data/raw/*
!data/raw/.gitkeep
# Exception: TomTom traffic collections are tracked (private repo; irreplaceable time series)
!data/raw/traffic/
data/raw/traffic/*.lock
data/processed/*
!data/processed/.gitkeep

# Model artifacts (shared via Drive, not git)
models/*
!models/.gitkeep
checkpoints/
logs/
*.pt
*.joblib
*.zip
*.pkl
faiss_index/
# Exception (must stay after the patterns above): trained models are tracked, flat in
# models/ (private repo; each file < 100 MB). models/whisper/ cache stays ignored.
!models/*.pt
!models/*.joblib
!models/*.zip
!models/*.pkl
!models/*.json

# SUMO outputs
sumo/*.out.xml
sumo/*tripinfo*.xml

# Audio recordings (consented WER set stays local/Drive)
*.wav
*.mp3
*.m4a
*.mp4
*.mov
# Exception: the ASR test clips are tracked (private repo only; consent required)
!data/asr_test/**/*.wav
data/asr_test/noise/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Smoke-test outputs (not results)
reports/*_quick.csv
